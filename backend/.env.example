# Copy this file to .env and edit as needed
DATABASE_URL=sqlite:///./sulabhai.db
# For Postgres (docker-compose): postgresql+psycopg2://sulabhai:sulabhai@postgres:5432/sulabhai

JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DEMO_MODE=true means no external AI API is called; answers are generated
# deterministically from retrieved document chunks (rule-based readability rewrite).
DEMO_MODE=true

# Only used if DEMO_MODE=false and you want to wire a real LLM later.
LLM_API_KEY=
LLM_PROVIDER=openai

UPLOAD_DIR=./uploads
